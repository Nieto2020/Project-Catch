# Copia este archivo a `.env` y añade tu API key para activar el asistente IA.
#
# OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# DeepSeek (compatible con OpenAI, se detecta automaticamente si el modelo
# contiene "deepseek"; no es necesario configurar OPENAI_BASE_URL):
# OPENAI_MODEL=deepseek-chat

# Voz del video descriptivo (edge-tts / Microsoft, natural):
# Opciones en espanol de Mexico: es-MX-JorgeNeural (hombre) | es-MX-DaliaNeural (mujer)
SCORE_VOICE=es-MX-JorgeNeural
